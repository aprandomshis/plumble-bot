# Pumble API Credentials
PUMBLE_BOT_TOKEN=your_pumble_bot_api_token_here
PUMBLE_WORKSPACE_ID=your_pumble_workspace_id_here
PUMBLE_SIGNING_SECRET=your_pumble_webhook_secret_here

# Groq AI API Configuration (Fast Llama 3 / Mixtral Inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# App URL (for webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
